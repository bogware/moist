<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moist.App.App"
             xmlns:local="using:Moist.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Moist.App/Themes/MoistTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- moist Dark skin — overlays on Fluent. Toggled via Settings > Theme. -->
        <StyleInclude Source="avares://Moist.App/Themes/MoistDark.axaml"/>
    </Application.Styles>
</Application>
