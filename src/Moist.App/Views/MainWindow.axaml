<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Moist.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Moist.App.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Moist.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://Moist.App/Assets/moist.ico"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="None">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- OffScreenMargin keeps the custom title bar from being clipped by the resize border
         when the window is maximized on Windows. -->
    <DockPanel Margin="{Binding OffScreenMargin, RelativeSource={RelativeSource AncestorType=Window}}">

        <!-- ═══ Top: Branded Header Bar (doubles as the custom title bar) ═══ -->
        <Border DockPanel.Dock="Top" Classes="titlebar" PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Classes="brand-title" Text="moist" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="1" Classes="brand-subtitle" Text="video encoder"
                           VerticalAlignment="Center" Margin="8,2,0,0"/>

                <!-- Startup warning -->
                <TextBlock Grid.Column="2" Text="{Binding StartupError}"
                           IsVisible="{Binding HasStartupError}"
                           Foreground="#FFFF6666" FontSize="11"
                           VerticalAlignment="Center" Margin="16,0"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="3" Content="About" Padding="10,4" FontSize="11"
                        Name="AboutButton" Click="AboutButton_Click"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Window caption buttons (replace the removed native title bar) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Stretch" HorizontalAlignment="Right">
                    <Button Classes="caption" Click="MinimizeButton_Click" ToolTip.Tip="Minimize">
                        <Path Width="10" Height="10" Stretch="None"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                              Data="M0,5 L10,5"/>
                    </Button>
                    <Button Classes="caption" Name="MaximizeButton" Click="MaximizeButton_Click"
                            ToolTip.Tip="Maximize">
                        <Path Name="MaximizeIcon" Width="10" Height="10" Stretch="None"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                              Data="M0,0 L10,0 L10,10 L0,10 Z"/>
                    </Button>
                    <Button Classes="caption close" Click="CloseButton_Click" ToolTip.Tip="Close">
                        <Path Width="10" Height="10" Stretch="None"
                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                              Data="M0,0 L10,10 M10,0 L0,10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Bottom: Status Bar ═══ -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="hint"
                           VerticalAlignment="Center"
                           Text="Ctrl+O Open  Ctrl+Q Queue  Ctrl+R Run  Ctrl+S Save  Ctrl+T Theme  Del/Space Queue  Ctrl+1-6 Tabs"/>
            </Grid>
        </Border>

        <!-- ═══ Main Content: Tabs ═══ -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="4,4,4,0">

            <TabItem Header="Encode">
                <views:EncodeTabView DataContext="{Binding EncodeTab}"/>
            </TabItem>

            <TabItem Header="Batch">
                <views:BatchTabView DataContext="{Binding BatchTab}"/>
            </TabItem>

            <TabItem Header="Filters">
                <views:FilterTabView DataContext="{Binding FilterTab}"/>
            </TabItem>

            <TabItem Header="Plugins">
                <views:PluginManagerView DataContext="{Binding PluginManager}"/>
            </TabItem>

            <TabItem Header="Queue">
                <views:QueueTabView DataContext="{Binding QueueTab}"/>
            </TabItem>

            <TabItem Header="Settings">
                <views:SettingsTabView DataContext="{Binding SettingsTab}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
