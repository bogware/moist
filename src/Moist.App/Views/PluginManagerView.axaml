<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moist.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Moist.App.Views.PluginManagerView"
             x:DataType="vm:PluginManagerViewModel">

    <DockPanel Margin="16">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Plugin Manager" FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="Manage filter plugins from local directories and online sources. Install, remove, and configure plugins for all filter engines."
                       TextWrapping="Wrap" Opacity="0.6" FontSize="12"/>
        </StackPanel>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="4" Padding="8,4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Opacity="0.7"/>
        </Border>

        <Grid ColumnDefinitions="300,*" ColumnSpacing="12">

            <!-- LEFT: Sources & Installed -->
            <DockPanel>
                <!-- Plugin Sources -->
                <Border DockPanel.Dock="Top"
                        Classes="section" Padding="12" Margin="0,0,0,12"
                        Height="240">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Plugin Sources" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                            <Button Content="Add Local..." Name="AddLocalSourceButton"
                                    Click="AddLocalSource_Click" Padding="8,4"/>
                            <Button Content="Remove" Command="{Binding RemoveSourceCommand}"
                                    CommandParameter="{Binding SelectedSource}" Padding="8,4"/>
                            <Button Content="Toggle" Command="{Binding ToggleSourceCommand}"
                                    CommandParameter="{Binding SelectedSource}" Padding="8,4"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Sources}"
                                 SelectedItem="{Binding SelectedSource}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginSourceViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <StackPanel Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                <Border Background="#44888888" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="9"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Location}" FontSize="10" Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusLabel}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Opacity="0.5"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Installed Plugins -->
                <Border Classes="section" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Installed Plugins" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,8"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                            <TextBlock Text="{Binding InstalledPlugins.Count, StringFormat={}{0} installed}"
                                       FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding InstalledPlugins}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginPackageViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                                           FontSize="10" Opacity="0.5"/>
                                                <TextBlock Text="{Binding Engine}" FontSize="10" Opacity="0.5"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Uninstall"
                                                Command="{Binding $parent[ListBox].((vm:PluginManagerViewModel)DataContext).UninstallPluginCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- RIGHT: Online Catalog (Marketplace) -->
            <Border Grid.Column="1"
                    Classes="section" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Marketplace" FontWeight="Bold" FontSize="16"
                                       VerticalAlignment="Center"/>
                            <Button Content="Refresh Catalog" Command="{Binding LoadOnlineCatalogCommand}"
                                    Padding="12,4"/>
                        </StackPanel>

                        <!-- Search and Filters -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding CatalogSearchText}"
                                     Watermark="Search plugins..."/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Static vm:PluginManagerViewModel.EngineFilters}"
                                      SelectedItem="{Binding CatalogEngineFilter}"
                                      PlaceholderText="Engine" Width="130"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{x:Static vm:PluginManagerViewModel.CategoryFilters}"
                                      SelectedItem="{Binding CatalogCategoryFilter}"
                                      PlaceholderText="Category" Width="130"/>
                        </Grid>
                    </StackPanel>

                    <!-- Loading Indicator -->
                    <TextBlock DockPanel.Dock="Top"
                               IsVisible="{Binding IsLoadingCatalog}"
                               Text="Loading catalog..."
                               HorizontalAlignment="Center" Opacity="0.5" Margin="0,0,0,8"/>

                    <!-- Empty State -->
                    <StackPanel IsVisible="{Binding !FilteredCatalog.Count}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="Click 'Refresh Catalog' to browse available plugins"
                                   FontSize="14" Opacity="0.3" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Catalog Grid -->
                    <DataGrid ItemsSource="{Binding FilteredCatalog}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              IsVisible="{Binding FilteredCatalog.Count}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="60"/>
                            <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:PluginPackageViewModel">
                                        <Button Content="Install"
                                                Command="{Binding $parent[DataGrid].((vm:PluginManagerViewModel)DataContext).InstallPluginCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding !IsInstalled}"
                                                Padding="6,2" FontSize="11"
                                                HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
