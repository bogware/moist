<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Moist.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Moist.App.Views.EncodeTabView"
             x:DataType="vm:EncodeTabViewModel"
             DragDrop.AllowDrop="True">

    <!-- The preview column is user-resizable via the GridSplitter; MinWidth keeps the settings
         readable. Default is wide enough to show source and output side by side. -->
    <Grid ColumnDefinitions="*,6,420">

        <!-- Left: Settings -->
        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="16" Margin="16">

                <!-- Input / Output Section with Drop Zone -->
                <Border Classes="section"
                        Name="DropZone">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Input / Output" Classes="section-header"/>

                        <!-- Drop Zone Overlay -->
                        <Border IsVisible="{Binding IsDragOver}"
                                Background="#3300AAFF" BorderBrush="#00AAFF"
                                BorderThickness="2" CornerRadius="8" Padding="24"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Drop video file here"
                                       HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#00AAFF"/>
                        </Border>

                        <Grid ColumnDefinitions="100,*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <TextBlock Text="Input:" VerticalAlignment="Center" Grid.Row="0"/>
                            <TextBox Text="{Binding InputFile}" Grid.Row="0" Grid.Column="1"
                                     Watermark="Drag and drop or browse for a video file..."/>
                            <Button Content="Browse" Grid.Row="0" Grid.Column="2"
                                    Name="BrowseInputButton" Click="BrowseInput_Click"/>
                            <Button Content="Analyze" Grid.Row="0" Grid.Column="3"
                                    Command="{Binding AnalyzeInputCommand}"/>

                            <TextBlock Text="Output:" VerticalAlignment="Center" Grid.Row="1"/>
                            <TextBox Text="{Binding OutputFile}" Grid.Row="1" Grid.Column="1"
                                     Watermark="Output file path..."/>
                            <Button Content="Browse" Grid.Row="1" Grid.Column="2"
                                    Name="BrowseOutputButton" Click="BrowseOutput_Click"/>
                            <ComboBox Grid.Row="1" Grid.Column="3"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.ContainerOptions}"
                                      SelectedItem="{Binding Container}"
                                      Width="100"/>
                        </Grid>

                        <!-- Status / Error Message (turns red on error) -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   Classes.error="{Binding HasError}"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontSize="12" Margin="0,4,0,0" Opacity="0.9"/>

                        <!-- Anything that will be quietly lost: HDR, chroma, dynamic metadata -->
                        <Border IsVisible="{Binding EncodeWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="#33FFAA00" BorderBrush="#FFAA00" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,4,0,0">
                            <TextBlock Text="{Binding EncodeWarnings}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <!-- Media Info Display -->
                        <Border IsVisible="{Binding MediaInfo, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                CornerRadius="4" Padding="12" Margin="0,4,0,0">
                            <TextBlock Text="{Binding MediaInfoSummary}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Profile Section -->
                <Border Classes="section">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Encoding Profile" Classes="section-header"/>
                        <TextBlock Text="A profile is a complete encode setup — codec, quality, audio, container and filters. Selecting one applies it; Update saves changes back. (Filter Presets, on the Filters tab, save just a filter chain.)"
                                   FontSize="11" Opacity="0.55" TextWrapping="Wrap" Margin="0,-2,0,2"/>
                        <Grid ColumnDefinitions="100,*,Auto,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="Profile:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="2" Content="Update"
                                    Command="{Binding UpdateProfileCommand}"
                                    ToolTip.Tip="Save the current settings back into the selected profile"
                                    IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <Button Grid.Column="3" Content="Save As..."
                                    Name="SaveProfileButton" Click="SaveProfile_Click"
                                    ToolTip.Tip="Save the current settings as a new named profile"/>
                            <Button Grid.Column="4" Content="Delete"
                                    Command="{Binding DeleteProfileCommand}"
                                    IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Video Encoder Section -->
                <Border Classes="section">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="Video Encoder" Classes="section-header"/>
                            <TextBlock Text="{Binding HardwareStatus}" VerticalAlignment="Center"
                                       FontSize="11" Opacity="0.6"
                                       IsVisible="{Binding HardwareStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*,120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <TextBlock Text="Codec:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VideoEncoders}"
                                      SelectedItem="{Binding SelectedVideoEncoder}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Mode:" VerticalAlignment="Center" Grid.Column="2"/>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.EncodingModeOptions}"
                                      SelectedItem="{Binding EncodingMode}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Quality/CRF:" VerticalAlignment="Center" Grid.Row="1"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        IsEnabled="{Binding IsQualityMode}">
                                <Slider Value="{Binding Quality}" Minimum="0" Maximum="51" Width="200"
                                        TickFrequency="1"/>
                                <TextBlock Text="{Binding Quality, StringFormat={}{0:F1}}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Preset:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
                            <ComboBox Grid.Row="1" Grid.Column="3"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.PresetOptions}"
                                      SelectedItem="{Binding Preset}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Tune:" VerticalAlignment="Center" Grid.Row="2"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.TuneOptions}"
                                      SelectedItem="{Binding Tune}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Bitrate:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="2"/>
                            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                        IsEnabled="{Binding IsBitrateMode}">
                                <NumericUpDown Value="{Binding Bitrate}" Minimum="100" Maximum="100000"
                                               Increment="500" Width="120"/>
                                <TextBlock Text="kbps" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="AV1 Preset:" VerticalAlignment="Center" Grid.Row="3"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding SvtAv1Preset}" Minimum="0" Maximum="13"
                                               Increment="1" Width="100"/>
                                <TextBlock Text="(0=slowest, 13=fastest)" VerticalAlignment="Center"
                                           FontSize="11" Opacity="0.6"/>
                            </StackPanel>

                            <TextBlock Text="Bit Depth:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="2"/>
                            <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <ComboBox ItemsSource="{x:Static vm:EncodeTabViewModel.BitDepthOptions}"
                                          SelectedItem="{Binding BitDepth}"
                                          Width="100"
                                          ToolTip.Tip="Auto follows the source. Forcing 8-bit on a 10-bit master discards precision."/>
                                <ComboBox ItemsSource="{x:Static vm:EncodeTabViewModel.ChromaOptions}"
                                          SelectedItem="{Binding Chroma}"
                                          Width="110"
                                          ToolTip.Tip="Chroma sampling. Auto follows the source; dropping 4:4:4 to 4:2:0 throws away colour resolution permanently."/>
                            </StackPanel>

                            <TextBlock Text="Custom Args:" VerticalAlignment="Center" Grid.Row="4"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                     Text="{Binding CustomVideoArgs}"
                                     Watermark="Additional encoder arguments..."/>

                            <!-- Target quality: pick a score, let moist find the CRF -->
                            <TextBlock Text="Target Quality:" VerticalAlignment="Center" Grid.Row="5"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{x:Static vm:EncodeTabViewModel.QualityMetricOptions}"
                                              SelectedItem="{Binding TargetMetric}"
                                              Width="100"
                                              ToolTip.Tip="VMAF is the usual choice — 95 is close to visually transparent."/>
                                    <NumericUpDown Value="{Binding TargetScore}" Minimum="0" Maximum="100"
                                                   Increment="1" Width="110"/>
                                    <Button Content="Find CRF"
                                            Command="{Binding FindTargetCrfCommand}"
                                            IsEnabled="{Binding !IsSearchingQuality}"
                                            Padding="12,4"
                                            ToolTip.Tip="Encodes a few short samples to find the CRF that reaches this score, then applies it."/>
                                    <TextBlock Text="searching…" VerticalAlignment="Center" FontSize="11"
                                               Opacity="0.7" IsVisible="{Binding IsSearchingQuality}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding QualitySearchStatus}" FontSize="11" Opacity="0.75"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding QualitySearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <!-- Chunked encoding -->
                            <TextBlock Text="Chunking:" VerticalAlignment="Center" Grid.Row="6"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                                        Orientation="Horizontal" Spacing="12">
                                <CheckBox Content="Split into parallel chunks"
                                          IsChecked="{Binding UseChunkedEncoding}"
                                          ToolTip.Tip="Encodes sections of the file at the same time and joins them. Helps most when the encoder can't use all your cores, and lets an interrupted encode resume."/>
                                <CheckBox Content="At scene cuts"
                                          IsChecked="{Binding ChunkSceneDetection}"
                                          IsEnabled="{Binding UseChunkedEncoding}"
                                          ToolTip.Tip="Costs an analysis pass, but boundaries land where a keyframe was going anyway."/>
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            IsEnabled="{Binding UseChunkedEncoding}">
                                    <TextBlock Text="max" VerticalAlignment="Center" FontSize="11"/>
                                    <NumericUpDown Value="{Binding MaxChunkSeconds}" Minimum="2" Maximum="600"
                                                   Increment="10" Width="100" FontSize="11"/>
                                    <TextBlock Text="s" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <CheckBox Content="Per-scene quality"
                                          IsChecked="{Binding UsePerSceneQuality}"
                                          IsEnabled="{Binding UseChunkedEncoding}"
                                          ToolTip.Tip="Give every scene its own CRF so the target quality is reached everywhere, instead of over-spending on easy scenes and starving hard ones. Uses the Target Quality setting above."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audio Encoder Section -->
                <Border Classes="section">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="Audio Encoder" Classes="section-header"/>
                            <CheckBox Content="Audio Only (no video)" IsChecked="{Binding AudioOnly}"
                                      VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="120,*,120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <!-- Row 0: Codec + Bitrate Mode -->
                            <TextBlock Text="Codec:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AudioEncoders}"
                                      SelectedItem="{Binding SelectedAudioEncoder}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Bitrate Mode:" VerticalAlignment="Center" Grid.Column="2"/>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.AudioBitrateModeOptions}"
                                      SelectedItem="{Binding AudioBitrateMode}"
                                      HorizontalAlignment="Stretch"/>

                            <!-- Row 1: Bitrate + Channel Mode -->
                            <TextBlock Text="Bitrate:" VerticalAlignment="Center" Grid.Row="1"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding AudioBitrate}" Minimum="8" Maximum="1536"
                                               Increment="32" Width="120"/>
                                <TextBlock Text="kbps" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Channels:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
                            <ComboBox Grid.Row="1" Grid.Column="3"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.AudioChannelModeOptions}"
                                      SelectedItem="{Binding AudioChannelMode}"
                                      HorizontalAlignment="Stretch"/>

                            <!-- Row 2: Sample Rate + Sample Format -->
                            <TextBlock Text="Sample Rate:" VerticalAlignment="Center" Grid.Row="2"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.SampleRateOptions}"
                                      SelectedItem="{Binding AudioSampleRate}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Sample Fmt:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="2"/>
                            <ComboBox Grid.Row="2" Grid.Column="3"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.SampleFormatOptions}"
                                      SelectedItem="{Binding AudioSampleFormat}"
                                      HorizontalAlignment="Stretch"/>

                            <!-- Row 3: Normalization -->
                            <TextBlock Text="Normalize:" VerticalAlignment="Center" Grid.Row="3"/>
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      ItemsSource="{x:Static vm:EncodeTabViewModel.NormalizationModeOptions}"
                                      SelectedItem="{Binding AudioNormalization}"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Target LUFS:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="2"/>
                            <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding NormalizationTarget}" Minimum="-70" Maximum="0"
                                               Increment="1" FormatString="F1" Width="100"/>
                                <TextBlock Text="TP:" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding TruePeakLimit}" Minimum="-10" Maximum="0"
                                               Increment="0.5" FormatString="F1" Width="80"/>
                            </StackPanel>

                            <!-- Row 4: Codec-specific options -->
                            <TextBlock Text="Codec Opts:" VerticalAlignment="Center" Grid.Row="4"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Opus Complexity:" VerticalAlignment="Center" FontSize="11"/>
                                    <NumericUpDown Value="{Binding OpusComplexity}" Minimum="0" Maximum="10"
                                                   Increment="1" Width="80" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="AAC Profile:" VerticalAlignment="Center" FontSize="11"/>
                                    <ComboBox ItemsSource="{x:Static vm:EncodeTabViewModel.AacProfileOptions}"
                                              SelectedItem="{Binding AacProfile}" Width="110" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="MP3 VBR:" VerticalAlignment="Center" FontSize="11"/>
                                    <NumericUpDown Value="{Binding Mp3VbrScale}" Minimum="0" Maximum="9"
                                                   Increment="1" Width="70" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="FLAC Level:" VerticalAlignment="Center" FontSize="11"/>
                                    <NumericUpDown Value="{Binding FlacCompressionLevel}" Minimum="0" Maximum="12"
                                                   Increment="1" Width="70" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Vorbis Q:" VerticalAlignment="Center" FontSize="11"/>
                                    <NumericUpDown Value="{Binding VorbisQuality}" Minimum="-1" Maximum="10"
                                                   Increment="1" Width="70" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Row 5: Custom audio args -->
                            <TextBlock Text="Custom Args:" VerticalAlignment="Center" Grid.Row="5"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                                     Text="{Binding CustomAudioArgs}"
                                     Watermark="Additional audio encoder arguments..."/>

                            <!-- Row 6: Audio Track -->
                            <TextBlock Text="Audio Track:" VerticalAlignment="Center" Grid.Row="6"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Spacing="4">
                                <ComboBox ItemsSource="{Binding AudioTrackLabels}"
                                          SelectedIndex="{Binding SelectedAudioTrackIndex}"
                                          IsEnabled="{Binding !EncodeAllAudioTracks}"
                                          HorizontalAlignment="Stretch"/>
                                <CheckBox Content="Encode all audio tracks"
                                          IsChecked="{Binding EncodeAllAudioTracks}"
                                          ToolTip.Tip="Encode every audio track in the source, keeping language and title on each."/>
                            </StackPanel>

                            <!-- Row 7: Subtitles -->
                            <TextBlock Text="Subtitles:" VerticalAlignment="Center" Grid.Row="7"/>
                            <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Spacing="4">
                                <CheckBox Content="Copy subtitles from source"
                                          IsChecked="{Binding CopySubtitles}"/>
                                <ItemsControl ItemsSource="{Binding SubtitleTrackLabels}" IsVisible="{Binding CopySubtitles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11" Opacity="0.6" Margin="20,0,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="External sub:" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding ExternalSubtitleFile}" Width="250"
                                             Watermark="(optional) .srt/.ass file"
                                             FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="Keep chapters" IsChecked="{Binding CopyChapters}"
                                              ToolTip.Tip="Carry chapter markers over from the source."/>
                                    <CheckBox Content="Keep attachments" IsChecked="{Binding CopyAttachments}"
                                              ToolTip.Tip="Carry attached fonts over (needed for styled subtitles). MKV only."/>
                                    <CheckBox Content="Burn in" IsChecked="{Binding BurnInSubtitles}"
                                              ToolTip.Tip="Render subtitles permanently into the picture, for players that can't display them. Cannot be combined with chunked encoding."/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Add to Queue Button -->
                <Button Content="Add to Queue"
                        Command="{Binding AddToQueueCommand}"
                        HorizontalAlignment="Right"
                        Padding="24,8"
                        FontSize="14"
                        Classes="accent"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Video Preview Panel -->
        <!-- Drag to resize the preview panel -->
        <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns"
                      Background="Transparent" HorizontalAlignment="Center"/>

        <Border Grid.Column="2" Classes="section" Margin="0,16,16,16" MinWidth="240">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Preview" Classes="section-header" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Full Preview ⤢"
                            Name="FullPreviewButton" Click="FullPreview_Click"
                            FontSize="11" Padding="8,3"
                            IsEnabled="{Binding MediaInfo, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Open a separate, resizable preview window with scrubbing and side-by-side before/after"/>
                </Grid>

                <!-- Controls: shared scrub + render/open output -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                    <Slider Value="{Binding PreviewPosition}"
                            Minimum="0"
                            Maximum="{Binding PreviewMaxPosition}"
                            IsEnabled="{Binding MediaInfo, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Text="{Binding PreviewPosition, StringFormat=Position: {0:F1}s}"
                               FontSize="11" Opacity="0.6" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding OutputRenderProgress}" Minimum="0" Maximum="100" Height="4"
                                 IsVisible="{Binding IsRenderingOutput}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button Content="Render output ▶"
                                Command="{Binding RenderOutputPreviewCommand}"
                                IsEnabled="{Binding !IsRenderingOutput}"
                                FontSize="11" Padding="8,3"
                                ToolTip.Tip="Render this frame through the full pipeline (filters + encoder + bit depth + AI) for a true before/after"/>
                        <Button Content="Open in player"
                                Command="{Binding OpenOutputSnippetCommand}"
                                IsEnabled="{Binding OutputPreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                FontSize="11" Padding="8,3"
                                ToolTip.Tip="Play the rendered output snippet with motion"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OutputPreviewStatus}" FontSize="10" Opacity="0.6"
                               TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="{Binding OutputPreviewStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Source | Output, side by side -->
                <Grid RowDefinitions="Auto,*,Auto,*">
                    <TextBlock Grid.Row="0" Text="Source" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="4">
                        <Panel>
                            <TextBlock Text="Loading..." IsVisible="{Binding IsPreviewLoading}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Open a video file to see preview"
                                       IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.3" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly"/>
                        </Panel>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Output (full pipeline)" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Center" Margin="0,8,0,4"/>
                    <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            CornerRadius="4">
                        <Panel>
                            <TextBlock Text="Rendering…" IsVisible="{Binding IsRenderingOutput}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Click “Render output” to&#xa;see it through the pipeline"
                                       IsVisible="{Binding OutputPreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.3" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                            <Image Source="{Binding OutputPreviewImage}" Stretch="Uniform" StretchDirection="DownOnly"/>
                        </Panel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
