<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="SharpCompress" Version="0.50.9" />
  </ItemGroup>

  <!-- Bundled GLSL upscaling shaders (FSRCNNX / Anime4K), run through FFmpeg's libplacebo
       filter. Copied next to the binary so GpuShaders.Directory can find them at runtime;
       Content flows to the referencing app/CLI output too. -->
  <ItemGroup>
    <Content Include="Shaders\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Argument-building helpers are internal by design, but they are exactly the parts
       worth asserting on without launching a process. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Moist.Core.Tests" />
    <InternalsVisibleTo Include="Moist.IntegrationTests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
