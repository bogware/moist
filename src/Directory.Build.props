<Project>

  <!--
    One version for the whole solution. It used to live in Moist.App.csproj and
    Moist.Cli.csproj separately, which meant the GUI and the CLI could — and did —
    report different versions of the same build.
  -->
  <PropertyGroup>
    <Version>1.0.1</Version>
    <Product>moist</Product>
    <Copyright>Copyright (c) 2024-2026 moist contributors</Copyright>
  </PropertyGroup>

  <!--
    On CI, normalise source paths to /_/ so release binaries and their PDBs don't carry the
    runner's working directory (and with it the runner account's home path).
  -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
